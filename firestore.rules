rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'phone', 'role', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 80
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 32))
        && data.role == 'hunter'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Health check document for startup getDocFromServer validation
    match /test/connection {
      allow get: if isSignedIn();
      allow list, write: if false;
    }

    // Hunter User Profiles (Owner-Only PII Isolation — No collection list allowed)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'updatedAt'])
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().role == existing().role
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if false;
    }
  }
}
